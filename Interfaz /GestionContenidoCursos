	private void crearTabla() {
		modeloTabla = crearModelo("ID", "Curso", "Orden", "Título", "Tipo", "Descripción");
		tabla = crearTablaEstilizada(modeloTabla,
				new int[] { 50, 170, 60, 220, 110, 350 }, 400, 200);
		lblTotal = crearEtiquetaTotal("Total de temas: 0");
	}

	private void crearEventos() {
		btnRegistrar.addActionListener(e -> registrar());
		btnModificar.addActionListener(e -> modificar());
		btnEliminar.addActionListener(e -> eliminar());
		btnLimpiar.addActionListener(e -> limpiar());
		btnVolver.addActionListener(e -> dispose());

		tabla.getSelectionModel().addListSelectionListener(e -> {
			if (!e.getValueIsAdjusting()) {
				seleccionarFila();
			}
		});

		cmbFiltroCurso.addActionListener(e -> refrescarTabla());

		cmbCurso.addActionListener(e -> sugerirOrden());
	}

	private void cargarCursos() {
		try {
			cmbFiltroCurso.addItem(new Opcion(0, "Todos los cursos"));
			for (Curso c : cursoServicio.listar()) {
				String texto = c.getNombre()
						+ ("ACTIVO".equals(c.getEstado()) ? "" : " (INACTIVO)");
				cmbCurso.addItem(new Opcion(c.getIdCurso(), texto));
				cmbFiltroCurso.addItem(new Opcion(c.getIdCurso(), texto));
				nombresCursos.put(c.getIdCurso(), c.getNombre());
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de cursos.", ex);
		}
	}

	private void cargarTabla() {
		try {
			listaContenidos = servicio.listar();
			listaContenidos.sort(Comparator.comparingInt(ContenidoCurso::getIdCurso)
					.thenComparingInt(ContenidoCurso::getOrden));
			refrescarTabla();
			sugerirOrden();
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar el contenido de los cursos.", ex);
		}
	}

	private void refrescarTabla() {
		int idFiltro = idDe(cmbFiltroCurso);
		modeloTabla.setRowCount(0);
		int mostrados = 0;

		for (ContenidoCurso c : listaContenidos) {
			if (idFiltro != 0 && c.getIdCurso() != idFiltro) {
				continue;
			}

			String curso = nombresCursos.get(c.getIdCurso());
			modeloTabla.addRow(new Object[] {
					c.getIdContenido(),
					curso == null ? "Curso #" + c.getIdCurso() : curso,
					String.valueOf(c.getOrden()),
					c.getTitulo(),
					c.getTipo(),
					nz(c.getDescripcion())
			});
			mostrados++;
		}
		lblTotal.setText("Total de temas: " + mostrados);
	}

	private void sugerirOrden() {
		if (!txtId.getText().isEmpty()) {
			return;
		}
		int idCurso = idDe(cmbCurso);
		int maximo = 0;
		for (ContenidoCurso c : listaContenidos) {
			if (c.getIdCurso() == idCurso) {
				maximo = Math.max(maximo, c.getOrden());
			}
		}
		txtOrden.setText(String.valueOf(maximo + 1));
	}

	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo un tema ya registrado.\n"
					+ "Presiona \"Limpiar\" para capturar uno nuevo.");
			return;
		}

		try {
			if (servicio.registrar(leerFormulario())) {
				info("Contenido registrado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo registrar el contenido.", ex);
		}
	}

	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un tema de la tabla para modificarlo.");
			return;
		}

		try {
			if (servicio.modificar(leerFormulario())) {
				info("Contenido modificado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo modificar el contenido.", ex);
		}
	}

	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un tema de la tabla para eliminarlo.");
			return;
		}

		int id = Integer.parseInt(txtId.getText());

		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar el tema \"" + txtTitulo.getText() + "\"?",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			if (servicio.eliminar(id)) {
				info("Contenido eliminado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo eliminar el contenido.", ex);
		}
	}

	private ContenidoCurso leerFormulario() {
		String titulo = txtTitulo.getText().trim();
		String descripcion = txtDescripcion.getText().trim();
		String ordenTexto = txtOrden.getText().trim();

		Object tipoEditor = cmbTipo.getEditor().getItem();
		String tipo = tipoEditor == null ? "" : tipoEditor.toString().trim();

		int idCurso = idDe(cmbCurso);
		if (idCurso <= 0) {
			throw new IllegalArgumentException("Selecciona el curso al que pertenece el tema.");
		}
		if (titulo.isEmpty()) {
			throw new IllegalArgumentException("El título del tema es obligatorio.");
		}
		if (titulo.length() > 150) {
			throw new IllegalArgumentException("El título no puede pasar de 150 caracteres.");
		}
		if (tipo.isEmpty()) {
			throw new IllegalArgumentException("El tipo de material es obligatorio.");
		}
		if (tipo.length() > 50) {
			throw new IllegalArgumentException("El tipo no puede pasar de 50 caracteres.");
		}

		int orden;
		try {
			orden = Integer.parseInt(ordenTexto);
		} catch (NumberFormatException ex) {
			throw new IllegalArgumentException("El orden debe ser un número entero.");
		}
		if (orden < 0) {
			throw new IllegalArgumentException("El orden no puede ser negativo.");
		}

		ContenidoCurso c = new ContenidoCurso();
		if (!txtId.getText().isEmpty()) {
			c.setIdContenido(Integer.parseInt(txtId.getText()));
		}
		c.setIdCurso(idCurso);
		c.setTitulo(titulo);
		c.setDescripcion(descripcion.isEmpty() ? null : descripcion);
		c.setTipo(tipo);
		c.setOrden(orden);
		return c;
	}

	private void seleccionarFila() {
		int fila = tabla.getSelectedRow();
		if (fila == -1) {
			return;
		}

		int id = (Integer) tabla.getValueAt(fila, 0);

		for (ContenidoCurso c : listaContenidos) {
			if (c.getIdContenido() == id) {
				txtId.setText(String.valueOf(c.getIdContenido()));
				seleccionarOpcion(cmbCurso, c.getIdCurso());
				txtTitulo.setText(c.getTitulo());
				cmbTipo.setSelectedItem(c.getTipo());
				txtOrden.setText(String.valueOf(c.getOrden()));
				txtDescripcion.setText(nz(c.getDescripcion()));
				break;
			}
		}
	}

	private void limpiar() {
		txtId.setText("");
		txtTitulo.setText("");
		txtDescripcion.setText("");
		cmbTipo.setSelectedIndex(0);
		tabla.clearSelection();
		sugerirOrden();
		txtTitulo.requestFocusInWindow();
	}

