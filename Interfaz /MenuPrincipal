	private void agregarEfectoHover(final JButton boton) {
		boton.addMouseListener(new MouseAdapter() {
			@Override
			public void mouseEntered(MouseEvent e) {
				boton.setBackground(AZUL_HOVER);
			}

			@Override
			public void mouseExited(MouseEvent e) {
				boton.setBackground(AZUL_OSCURO);
			}
		});
	}

	private void abrir(JFrame ventana) {
		ventana.addWindowListener(new WindowAdapter() {
			@Override
			public void windowClosed(WindowEvent e) {
				cargarResumen();
			}
		});
		ventana.setVisible(true);
	}

	private void cargarResumen() {
		try {
			int totalCursos = cursoServicio.listar().size();

			int alumnosActivos = 0;
			for (Alumno a : alumnoServicio.listar()) {
				if ("ACTIVO".equals(a.getEstado())) {
					alumnosActivos++;
				}
			}

			int pagados = 0;
			int pendientes = 0;
			for (Pago p : pagoServicio.listar()) {
				if ("PAGADO".equals(p.getEstado())) {
					pagados++;
				} else if ("PENDIENTE".equals(p.getEstado())) {
					pendientes++;
				}
			}

			lblNumCursos.setText(String.valueOf(totalCursos));
			lblNumAlumnos.setText(String.valueOf(alumnosActivos));
			lblNumPagados.setText(String.valueOf(pagados));
			lblNumPendientes.setText(String.valueOf(pendientes));
			lblBienvenida.setForeground(GRIS);
			lblBienvenida.setText("Bienvenido a EduControl");

		} catch (SQLException ex) {
			lblNumCursos.setText("-");
			lblNumAlumnos.setText("-");
			lblNumPagados.setText("-");
			lblNumPendientes.setText("-");
			lblBienvenida.setForeground(ROJO);
			lblBienvenida.setText("No se pudo cargar el resumen: " + ex.getMessage());
		}
	}

	public void establecerUsuario(String nombre, String rol) {
		lblUsuario.setText(nombre + " | " + rol);

		if ("ALUMNO".equalsIgnoreCase(rol)) {
			aplicarVistaAlumno();
		}
	}

