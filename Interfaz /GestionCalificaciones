	private void cargarCatalogos() {
		try {
			for (Alumno a : alumnoServicio.listar()) {
				alumnos.put(a.getIdAlumno(), a);
			}
			for (Curso c : cursoServicio.listar()) {
				cursos.put(c.getIdCurso(), c);
			}

			cmbFiltroInscripcion.addItem(new Opcion(0, "Todas las inscripciones"));
			for (Inscripcion i : inscripcionServicio.listar()) {
				inscripciones.put(i.getIdInscripcion(), i);
				Opcion opcion = new Opcion(i.getIdInscripcion(), textoInscripcion(i));
				cmbInscripcion.addItem(opcion);
				cmbFiltroInscripcion.addItem(opcion);
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudieron cargar las inscripciones.", ex);
		}
	}

	private String nombreAlumno(int idAlumno) {
		Alumno a = alumnos.get(idAlumno);
		return a == null ? "Alumno #" + idAlumno : a.getNombre() + " " + a.getApellidos();
	}

	private String nombreCurso(int idCurso) {
		Curso c = cursos.get(idCurso);
		return c == null ? "Curso #" + idCurso : c.getNombre();
	}

	private String textoInscripcion(Inscripcion i) {
		return "#" + i.getIdInscripcion() + " - " + nombreAlumno(i.getIdAlumno())
				+ " - " + nombreCurso(i.getIdCurso());
	}

	private void cargarTabla() {
		try {
			listaCalificaciones = servicio.listar();
			refrescarTabla();
			actualizarPromedio();
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de calificaciones.", ex);
		}
	}

	private void refrescarTabla() {
		int idFiltro = idDe(cmbFiltroInscripcion);
		modeloTabla.setRowCount(0);
		int mostrados = 0;

		for (Calificacion c : listaCalificaciones) {
			if (idFiltro != 0 && c.getIdInscripcion() != idFiltro) {
				continue;
			}

			Inscripcion ins = inscripciones.get(c.getIdInscripcion());
			modeloTabla.addRow(new Object[] {
					c.getIdCalificacion(),
					ins == null ? "-" : nombreAlumno(ins.getIdAlumno()),
					ins == null ? "-" : nombreCurso(ins.getIdCurso()),
					c.getTipoEvaluacion(),
					c.getCalificacion().setScale(2, RoundingMode.HALF_UP).toPlainString(),
					c.getFechaEvaluacion().format(FORMATO_FECHA),
					nz(c.getObservaciones())
			});
			mostrados++;
		}
		lblTotal.setText("Total de evaluaciones: " + mostrados);
	}

	private void actualizarPromedio() {
		int idInscripcion = idDe(cmbInscripcion);
		if (idInscripcion <= 0) {
			lblPromedio.setText("Selecciona una inscripción.");
			return;
		}

		BigDecimal suma = BigDecimal.ZERO;
		int cantidad = 0;
		for (Calificacion c : listaCalificaciones) {
			if (c.getIdInscripcion() == idInscripcion) {
				suma = suma.add(c.getCalificacion());
				cantidad++;
			}
		}

		if (cantidad == 0) {
			lblPromedio.setText("Sin evaluaciones todavía");
		} else {
			BigDecimal promedio = suma.divide(BigDecimal.valueOf(cantidad), 2, RoundingMode.HALF_UP);
			lblPromedio.setText(promedio.toPlainString() + "  (" + cantidad
					+ (cantidad == 1 ? " evaluación)" : " evaluaciones)"));
		}
	}

	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo una calificación ya registrada.\n"
					+ "Presiona \"Limpiar\" para capturar una nueva.");
			return;
		}

		try {
			if (servicio.registrar(leerFormulario())) {
				info("Calificación registrada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo registrar la calificación.", ex);
		}
	}

	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona una calificación de la tabla para modificarla.");
			return;
		}

		try {
			if (servicio.modificar(leerFormulario())) {
				info("Calificación modificada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo modificar la calificación.", ex);
		}
	}

	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona una calificación de la tabla para eliminarla.");
			return;
		}

		int id = Integer.parseInt(txtId.getText());

		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar esta calificación?",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			if (servicio.eliminar(id)) {
				info("Calificación eliminada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo eliminar la calificación.", ex);
		}
	}
	
	private Calificacion leerFormulario() {
		int idInscripcion = idDe(cmbInscripcion);
		if (idInscripcion <= 0) {
			throw new IllegalArgumentException("Selecciona la inscripción (alumno y curso).");
		}

		String notaTexto = txtCalificacion.getText().trim();
		if (notaTexto.isEmpty()) {
			throw new IllegalArgumentException("La calificación es obligatoria.");
		}
		BigDecimal nota = parsearDecimal(notaTexto, "La calificación");
		if (nota.signum() < 0 || nota.compareTo(BigDecimal.TEN) > 0) {
			throw new IllegalArgumentException("La calificación debe estar entre 0 y 10.");
		}

		if (txtFecha.getText().trim().isEmpty()) {
			throw new IllegalArgumentException("La fecha de evaluación es obligatoria.");
		}

		String observaciones = txtObservaciones.getText().trim();

		Calificacion c = new Calificacion();
		if (!txtId.getText().isEmpty()) {
			c.setIdCalificacion(Integer.parseInt(txtId.getText()));
		}
		c.setIdInscripcion(idInscripcion);
		c.setTipoEvaluacion((String) cmbTipo.getSelectedItem());
		c.setCalificacion(nota);
		c.setFechaEvaluacion(parsearFecha(txtFecha.getText()));
		c.setObservaciones(observaciones.isEmpty() ? null : observaciones);
		return c;
	}

	private void seleccionarFila() {
		int fila = tabla.getSelectedRow();
		if (fila == -1) {
			return;
		}

		int id = (Integer) tabla.getValueAt(fila, 0);

		for (Calificacion c : listaCalificaciones) {
			if (c.getIdCalificacion() == id) {
				txtId.setText(String.valueOf(c.getIdCalificacion()));
				seleccionarOpcion(cmbInscripcion, c.getIdInscripcion());
				cmbTipo.setSelectedItem(c.getTipoEvaluacion());
				txtCalificacion.setText(
						c.getCalificacion().setScale(2, RoundingMode.HALF_UP).toPlainString());
				txtFecha.setText(c.getFechaEvaluacion().format(FORMATO_FECHA));
				txtObservaciones.setText(nz(c.getObservaciones()));
				break;
			}
		}
	}

	private void limpiar() {
		txtId.setText("");
		txtCalificacion.setText("");
		txtFecha.setText(hoy());
		txtObservaciones.setText("");
		cmbTipo.setSelectedIndex(0);
		tabla.clearSelection();
		txtCalificacion.requestFocusInWindow();
	}

