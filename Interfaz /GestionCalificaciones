	private JTextArea agregarAreaTexto(JPanel panel, int x, int y, int ancho, int alto) {
		JTextArea area = new JTextArea();
		area.setFont(new Font("SansSerif", Font.PLAIN, 14));
		area.setForeground(AZUL_OSCURO);
		area.setLineWrap(true);
		area.setWrapStyleWord(true);
		area.setBorder(new EmptyBorder(4, 8, 4, 8));

		JScrollPane scroll = new JScrollPane(area);
		scroll.setBorder(new LineBorder(BORDE, 1));
		scroll.setBounds(x, y, ancho, alto);
		panel.add(scroll);
		return area;
	}

	private static class Opcion {
		final int id;
		final String texto;

		Opcion(int id, String texto) {
			this.id = id;
			this.texto = texto;
		}

		@Override
		public String toString() {
			return texto;
		}
	}

	private void seleccionarOpcion(JComboBox<Opcion> combo, int id) {
		for (int i = 0; i < combo.getItemCount(); i++) {
			if (combo.getItemAt(i).id == id) {
				combo.setSelectedIndex(i);
				return;
			}
		}
	}

	private int idDe(JComboBox<Opcion> combo) {
		Opcion opcion = (Opcion) combo.getSelectedItem();
		return opcion == null ? 0 : opcion.id;
	}

	private LocalDate parsearFecha(String texto) {
		try {
			return LocalDate.parse(texto.trim(), FORMATO_FECHA);
		} catch (DateTimeParseException ex) {
			throw new IllegalArgumentException(
					"Fecha inválida. Usa el formato dd/mm/aaaa (ejemplo: 25/03/2026).");
		}
	}

	private String hoy() {
		return LocalDate.now().format(FORMATO_FECHA);
	}

	private BigDecimal parsearDecimal(String texto, String campo) {
		String limpio = texto.replace("$", "").replace(" ", "");
		if (limpio.contains(".") && limpio.contains(",")) {
			limpio = limpio.replace(",", "");
		} else {
			limpio = limpio.replace(',', '.');
		}
		try {
			return new BigDecimal(limpio).setScale(2, RoundingMode.HALF_UP);
		} catch (NumberFormatException ex) {
			throw new IllegalArgumentException(campo + " debe ser un número válido.");
		}
	}
