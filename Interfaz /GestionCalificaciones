	private DefaultTableModel crearModelo(String... columnas) {
		return new DefaultTableModel(columnas, 0) {
			private static final long serialVersionUID = 1L;

			@Override
			public boolean isCellEditable(int fila, int columna) {
				return false;
			}

			@Override
			public Class<?> getColumnClass(int columna) {
				return columna == 0 ? Integer.class : String.class;
			}
		};
	}

	private JTable crearTablaEstilizada(DefaultTableModel modelo, int[] anchos,
			int y, int alto) {
		JTable t = new JTable(modelo);
		t.setFont(new Font("SansSerif", Font.PLAIN, 13));
		t.setRowHeight(26);
		t.setForeground(AZUL_OSCURO);
		t.setGridColor(new Color(225, 232, 243));
		t.setSelectionBackground(new Color(219, 234, 254));
		t.setSelectionForeground(AZUL_OSCURO);
		t.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
		t.getTableHeader().setReorderingAllowed(false);
		t.setAutoCreateRowSorter(true);

		DefaultTableCellRenderer encabezado = new DefaultTableCellRenderer() {
			private static final long serialVersionUID = 1L;

			@Override
			public Component getTableCellRendererComponent(JTable tb, Object valor,
					boolean seleccionado, boolean foco, int fila, int columna) {
				JLabel l = (JLabel) super.getTableCellRendererComponent(
						tb, valor, seleccionado, foco, fila, columna);
				l.setOpaque(true);
				l.setBackground(AZUL_OSCURO);
				l.setForeground(Color.WHITE);
				l.setFont(new Font("SansSerif", Font.BOLD, 13));
				l.setHorizontalAlignment(SwingConstants.LEFT);
				l.setBorder(new EmptyBorder(0, 8, 0, 8));
				return l;
			}
		};

		for (int i = 0; i < anchos.length; i++) {
			t.getColumnModel().getColumn(i).setPreferredWidth(anchos[i]);
			t.getColumnModel().getColumn(i).setHeaderRenderer(encabezado);
		}
		t.getTableHeader().setPreferredSize(new Dimension(100, 30));

		JScrollPane scroll = new JScrollPane(t);
		scroll.setBorder(new LineBorder(BORDE));
		scroll.getViewport().setBackground(Color.WHITE);
		scroll.setBounds(20, y, 960, alto);
		contentPane.add(scroll);
		return t;
	}

