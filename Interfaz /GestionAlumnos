			}
 
			@Override
			public void changedUpdate(DocumentEvent e) {
				filtrar();
			}
		});
	}
 
	private void cargarTabla() {
		try {
			listaAlumnos = servicio.listar();
			modeloTabla.setRowCount(0);
 
			for (Alumno a : listaAlumnos) {
				modeloTabla.addRow(new Object[] {
						a.getIdAlumno(),
						a.getNombre(),
						a.getApellidos(),
						a.getTelefono(),
						a.getCorreo(),
						a.getDireccion(),
						a.getFechaNacimiento() == null ? ""
								: a.getFechaNacimiento().format(FORMATO_FECHA),
						a.getEstado(),
						a.getIdUsuario() == null ? "No" : "Sí"
				});
			}
			lblTotal.setText("Total de alumnos: " + listaAlumnos.size());
 
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de alumnos.", ex);
		}
	}
 
	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo un alumno ya registrado.\n"
					+ "Presiona \"Limpiar\" para capturar uno nuevo.");
			return;
		}
 
		try {
			Alumno alumno = leerFormulario();
 
			if (servicio.registrar(alumno)) {
				info("Alumno registrado correctamente.");
				limpiar();
				cargarTabla();
			}
 
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			if (ex.getErrorCode() == 1062) {
				aviso("Ya existe un alumno registrado con ese correo electrónico.");
			} else {
				mostrarErrorBD("No se pudo registrar el alumno.", ex);
			}
		}
	}
 
	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un alumno de la tabla para modificarlo.");
			return;
		}
 
		try {
			Alumno alumno = leerFormulario();
 
			if (servicio.modificar(alumno)) {
				info("Alumno modificado correctamente.");
				limpiar();
				cargarTabla();
			}
 
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			if (ex.getErrorCode() == 1062) {
				aviso("Ese correo electrónico ya pertenece a otro alumno.");
			} else {
				mostrarErrorBD("No se pudo modificar el alumno.", ex);
			}
		}
	}
 
	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un alumno de la tabla para eliminarlo.");
			return;
		}
 
		int id = Integer.parseInt(txtId.getText());
		String nombre = txtNombre.getText() + " " + txtApellidos.getText();
 
		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar a " + nombre + "?",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);
 
		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}
 
		try {
			if (servicio.eliminar(id)) {
				info("Alumno eliminado correctamente.");
				limpiar();
				cargarTabla();
			}
 
		} catch (SQLException ex) {
			if (esLlaveForanea(ex)) {
				ofrecerDarDeBaja(id);
			} else {
				mostrarErrorBD("No se pudo eliminar el alumno.", ex);
			}
		}
	}
 
	private void ofrecerDarDeBaja(int id) {
		int opcion = JOptionPane.showConfirmDialog(this,
				"Este alumno tiene inscripciones registradas, por lo que no se puede eliminar.\n"
						+ "¿Deseas darlo de baja (estado INACTIVO) para conservar su historial?",
				"No se puede eliminar", JOptionPane.YES_NO_OPTION,
				JOptionPane.QUESTION_MESSAGE);
 
		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}
 
		try {
			Alumno alumno = servicio.buscarPorId(id);
			if (alumno != null) {
				alumno.setEstado("INACTIVO");
				servicio.modificar(alumno);
				info("El alumno fue dado de baja (INACTIVO).");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo dar de baja al alumno.", ex);
		}
	}
 
	private Alumno leerFormulario() {
		String nombre = txtNombre.getText().trim();
		String apellidos = txtApellidos.getText().trim();
		String telefono = txtTelefono.getText().trim();
		String correo = txtCorreo.getText().trim();
		String direccion = txtDireccion.getText().trim();
		String fechaTexto = txtFecha.getText().trim();
 
		if (nombre.isEmpty() || apellidos.isEmpty()
				|| correo.isEmpty() || fechaTexto.isEmpty()) {
			throw new IllegalArgumentException(
					"Nombre, apellidos, correo y fecha de nacimiento son obligatorios.");
		}
		if (nombre.length() > 50) {
			throw new IllegalArgumentException("El nombre no puede pasar de 50 caracteres.");
		}
		if (apellidos.length() > 100) {
			throw new IllegalArgumentException("Los apellidos no pueden pasar de 100 caracteres.");
		}
		if (correo.length() > 100
				|| !correo.matches("^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")) {
			throw new IllegalArgumentException("Ingresa un correo electrónico válido.");
		}
		if (!telefono.isEmpty() && !telefono.matches("\\d{7,15}")) {
			throw new IllegalArgumentException(
					"El teléfono debe contener solo números (de 7 a 15 dígitos).");
		}
		if (direccion.length() > 200) {
			throw new IllegalArgumentException("La dirección no puede pasar de 200 caracteres.");
		}
 
		LocalDate fecha;
		try {
			fecha = LocalDate.parse(fechaTexto, FORMATO_FECHA);
		} catch (DateTimeParseException ex) {
			throw new IllegalArgumentException(
					"Fecha inválida. Usa el formato dd/mm/aaaa (ejemplo: 25/03/2005).");
		}
		if (fecha.isAfter(LocalDate.now())) {
			throw new IllegalArgumentException("La fecha de nacimiento no puede ser futura.");
		}
 
		Alumno a = new Alumno();
		if (!txtId.getText().isEmpty()) {
			a.setIdAlumno(Integer.parseInt(txtId.getText()));
		}
		a.setNombre(nombre);
		a.setApellidos(apellidos);
		a.setTelefono(telefono.isEmpty() ? null : telefono);
		a.setCorreo(correo);
		a.setDireccion(direccion.isEmpty() ? null : direccion);
		a.setFechaNacimiento(fecha);
		a.setEstado((String) cmbEstado.getSelectedItem());
		a.setIdUsuario(idUsuarioSeleccionado); 
		return a;
	}
 
	private void seleccionarFila() {
		int filaVista = tabla.getSelectedRow();
		if (filaVista == -1) {
			return;
		}
 
		int filaModelo = tabla.convertRowIndexToModel(filaVista);
		int id = (Integer) modeloTabla.getValueAt(filaModelo, 0);
 
		for (Alumno a : listaAlumnos) {
			if (a.getIdAlumno() == id) {
				txtId.setText(String.valueOf(a.getIdAlumno()));
				txtNombre.setText(a.getNombre());
				txtApellidos.setText(a.getApellidos());
				txtTelefono.setText(a.getTelefono() == null ? "" : a.getTelefono());
				txtCorreo.setText(a.getCorreo());
				txtDireccion.setText(a.getDireccion() == null ? "" : a.getDireccion());
				txtFecha.setText(a.getFechaNacimiento() == null ? ""
						: a.getFechaNacimiento().format(FORMATO_FECHA));
				cmbEstado.setSelectedItem(a.getEstado());
				idUsuarioSeleccionado = a.getIdUsuario();
				break;
			}
		}
	}
 
	private void crearAcceso() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un alumno de la tabla para crearle su acceso.");
			return;
		}

		try {
			Alumno alumno = servicio.buscarPorId(Integer.parseInt(txtId.getText()));

			if (alumno == null) {
				aviso("No se encontró al alumno.");
				return;
			}
			if (alumno.getIdUsuario() != null) {
				aviso("Este alumno ya tiene acceso al sistema.\nEntra con su correo: "
						+ alumno.getCorreo());
				return;
			}
			if (!"ACTIVO".equals(alumno.getEstado())) {
				aviso("El alumno está INACTIVO. Actívalo antes de crearle acceso.");
				return;
			}

			JPasswordField txtClave = new JPasswordField();
			JPasswordField txtClave2 = new JPasswordField();
			Object[] contenido = {
					"Se creará una cuenta para " + alumno.getNombre() + " "
							+ alumno.getApellidos() + ".\nEntrará con su correo ("
							+ alumno.getCorreo() + ")\ny la contraseña que escribas aquí:",
					"Contraseña:", txtClave,
					"Confirmar contraseña:", txtClave2 };

			int opcion = JOptionPane.showConfirmDialog(this, contenido,
					"Crear acceso al sistema", JOptionPane.OK_CANCEL_OPTION,
					JOptionPane.PLAIN_MESSAGE);

			if (opcion != JOptionPane.OK_OPTION) {
				return;
			}

			String clave = new String(txtClave.getPassword());
			String clave2 = new String(txtClave2.getPassword());

			if (!clave.equals(clave2)) {
				aviso("Las contraseñas no coinciden.");
				return;
			}

			usuarioServicio.crearAccesoAlumno(alumno, clave);

			info("Acceso creado correctamente.\n\nCorreo: " + alumno.getCorreo()
					+ "\nEl alumno ya puede iniciar sesión.");
			limpiar();
			cargarTabla();

		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo crear el acceso.", ex);
		}
	}

	private void limpiar() {
		txtId.setText("");
		txtNombre.setText("");
		txtApellidos.setText("");
		txtTelefono.setText("");
		txtCorreo.setText("");
		txtDireccion.setText("");
		txtFecha.setText("");
		cmbEstado.setSelectedItem("ACTIVO");
		idUsuarioSeleccionado = null;
		tabla.clearSelection();
		txtNombre.requestFocusInWindow();
	}
 
	private void filtrar() {
		String texto = txtBuscar.getText().trim();
		if (texto.isEmpty()) {
			sorter.setRowFilter(null);
		} else {
			sorter.setRowFilter(RowFilter.regexFilter("(?i)" + Pattern.quote(texto)));
		}
	}
 
	private boolean esLlaveForanea(SQLException ex) {
		return ex instanceof SQLIntegrityConstraintViolationException
				|| ex.getErrorCode() == 1451;
	}
 
	private void aviso(String mensaje) {
		JOptionPane.showMessageDialog(this, mensaje, "Datos inválidos",
				JOptionPane.WARNING_MESSAGE);
	}
 
	private void info(String mensaje) {
		JOptionPane.showMessageDialog(this, mensaje, "EduControl",
				JOptionPane.INFORMATION_MESSAGE);
	}
 
	private void mostrarErrorBD(String mensaje, SQLException ex) {
		JOptionPane.showMessageDialog(this,
				mensaje + "\n" + ex.getMessage(),
				"Error de base de datos", JOptionPane.ERROR_MESSAGE);
	}
 
	private void agregarEtiqueta(JPanel panel, String texto, int x, int y) {
		JLabel etiqueta = new JLabel(texto);
		etiqueta.setFont(new Font("SansSerif", Font.BOLD, 13));
		etiqueta.setForeground(AZUL_OSCURO);
		etiqueta.setBounds(x, y, 300, 20);
		panel.add(etiqueta);
	}
 
	private JTextField agregarCampo(JPanel panel, int x, int y, int ancho) {
		JTextField campo = new JTextField();
		estilizarCampo(campo);
		campo.setBounds(x, y, ancho, 32);
		panel.add(campo);
		return campo;
	}
 
	private void estilizarCampo(JTextField campo) {
		campo.setFont(new Font("SansSerif", Font.PLAIN, 14));
		campo.setForeground(AZUL_OSCURO);
		campo.setBorder(BorderFactory.createCompoundBorder(
				new LineBorder(BORDE, 1), new EmptyBorder(4, 8, 4, 8)));
	}
 
	private void estilizarBoton(JButton boton, Color fondo, Color texto) {
		boton.setUI(new BasicButtonUI());
		boton.setFont(new Font("SansSerif", Font.BOLD, 14));
		boton.setBackground(fondo);
		boton.setForeground(texto);
		boton.setOpaque(true);
		boton.setContentAreaFilled(true);
		boton.setBorderPainted(false);
		boton.setFocusPainted(false);
		boton.setCursor(new Cursor(Cursor.HAND_CURSOR));
	}
}
