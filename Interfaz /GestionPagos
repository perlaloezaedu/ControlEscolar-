		txtDesde.setText("");
		txtHasta.setText("");
	}

	private BigDecimal totalPagado(int idInscripcion, int idPagoExcluido) {
		BigDecimal total = BigDecimal.ZERO;
		for (Pago p : listaPagos) {
			if (p.getIdInscripcion() == idInscripcion
					&& p.getIdPago() != idPagoExcluido
					&& "PAGADO".equals(p.getEstado())) {
				total = total.add(p.getMonto());
			}
		}
		return total;
	}

	private BigDecimal costoCurso(int idInscripcion) {
		Inscripcion ins = inscripciones.get(idInscripcion);
		if (ins == null) {
			return BigDecimal.ZERO;
		}
		Curso curso = cursos.get(ins.getIdCurso());
		return curso == null ? BigDecimal.ZERO : curso.getPrecio();
	}

	private BigDecimal saldoPendiente(int idInscripcion, int idPagoExcluido) {
		BigDecimal saldo = costoCurso(idInscripcion)
				.subtract(totalPagado(idInscripcion, idPagoExcluido));
		return saldo.signum() < 0 ? BigDecimal.ZERO : saldo;
	}

	private void actualizarResumen() {
		int idInscripcion = idDe(cmbInscripcion);
		if (idInscripcion <= 0) {
			lblResumen.setText("Selecciona una inscripción.");
			return;
		}

		BigDecimal costo = costoCurso(idInscripcion);
		BigDecimal pagado = totalPagado(idInscripcion, 0);
		BigDecimal saldo = saldoPendiente(idInscripcion, 0);

		lblResumen.setText("Costo: " + dinero(costo) + "   |   Pagado: " + dinero(pagado)
				+ "   |   Saldo: " + dinero(saldo));
	}

	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo un pago ya registrado.\n"
					+ "Presiona \"Limpiar\" para capturar uno nuevo.");
			return;
		}

		try {
			Pago pago = leerFormulario();
			if (!confirmarSiExcede(pago)) {
				return;
			}

			if (servicio.registrar(pago)) {
				info("Pago registrado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo registrar el pago.", ex);
		}
	}

	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un pago de la tabla para modificarlo.");
			return;
		}

		try {
			Pago pago = leerFormulario();
			if (!confirmarSiExcede(pago)) {
				return;
			}

			if (servicio.modificar(pago)) {
				info("Pago modificado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo modificar el pago.", ex);
		}
	}

	private boolean confirmarSiExcede(Pago pago) {
		if (!"PAGADO".equals(pago.getEstado())) {
			return true;
		}

		BigDecimal saldo = saldoPendiente(pago.getIdInscripcion(), pago.getIdPago());
		if (pago.getMonto().compareTo(saldo) <= 0) {
			return true;
		}

		int opcion = JOptionPane.showConfirmDialog(this,
				"El monto (" + dinero(pago.getMonto()) + ") es mayor al saldo pendiente ("
						+ dinero(saldo) + ").\n¿Deseas registrarlo de todos modos?",
				"El pago excede el adeudo", JOptionPane.YES_NO_OPTION,
				JOptionPane.WARNING_MESSAGE);
		return opcion == JOptionPane.YES_OPTION;
	}

	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un pago de la tabla para eliminarlo.");
			return;
		}

		int id = Integer.parseInt(txtId.getText());

		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar este pago?",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			if (servicio.eliminar(id)) {
				info("Pago eliminado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo eliminar el pago.", ex);
		}
	}

	private Pago leerFormulario() {
		int idInscripcion = idDe(cmbInscripcion);
		if (idInscripcion <= 0) {
			throw new IllegalArgumentException("Selecciona la inscripción (alumno y curso).");
		}

		String montoTexto = txtMonto.getText().trim();
		if (montoTexto.isEmpty()) {
			throw new IllegalArgumentException("El monto es obligatorio.");
		}
		BigDecimal monto = parsearDecimal(montoTexto, "El monto");
		if (monto.signum() <= 0) {
			throw new IllegalArgumentException("El monto debe ser mayor que cero.");
		}

		if (txtFecha.getText().trim().isEmpty()) {
			throw new IllegalArgumentException("La fecha de pago es obligatoria.");
		}

		Pago p = new Pago();
		if (!txtId.getText().isEmpty()) {
			p.setIdPago(Integer.parseInt(txtId.getText()));
		}
		p.setIdInscripcion(idInscripcion);
		p.setMonto(monto);
		p.setFechaPago(parsearFecha(txtFecha.getText()));
		p.setMetodoPago((String) cmbMetodo.getSelectedItem());
		p.setEstado((String) cmbEstado.getSelectedItem());
		return p;
	}

	private void seleccionarFila() {
		int fila = tabla.getSelectedRow();
		if (fila == -1) {
			return;
		}

		int id = (Integer) tabla.getValueAt(fila, 0);

		for (Pago p : listaPagos) {
			if (p.getIdPago() == id) {
				txtId.setText(String.valueOf(p.getIdPago()));
				seleccionarOpcion(cmbInscripcion, p.getIdInscripcion());
				txtMonto.setText(p.getMonto().toPlainString());
				txtFecha.setText(p.getFechaPago().format(FORMATO_FECHA));
				cmbMetodo.setSelectedItem(p.getMetodoPago());
				cmbEstado.setSelectedItem(p.getEstado());
				break;
			}
		}
	}

	private void limpiar() {
		txtId.setText("");
		txtMonto.setText("");
		txtFecha.setText(hoy());
		cmbMetodo.setSelectedIndex(0);
		cmbEstado.setSelectedItem("PAGADO");
		tabla.clearSelection();
		txtMonto.requestFocusInWindow();
	}

