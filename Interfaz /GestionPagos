	private void cargarCatalogos() {
		try {
			for (Alumno a : alumnoServicio.listar()) {
				alumnos.put(a.getIdAlumno(), a);
			}
			for (Curso c : cursoServicio.listar()) {
				cursos.put(c.getIdCurso(), c);
			}

			cmbFiltroAlumno.addItem(new Opcion(0, "Todos los alumnos"));
			for (Alumno a : alumnos.values()) {
				cmbFiltroAlumno.addItem(new Opcion(a.getIdAlumno(),
						a.getNombre() + " " + a.getApellidos()));
			}

			for (Inscripcion i : inscripcionServicio.listar()) {
				inscripciones.put(i.getIdInscripcion(), i);
				cmbInscripcion.addItem(new Opcion(i.getIdInscripcion(), textoInscripcion(i)));
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudieron cargar las inscripciones.", ex);
		}
	}

	private String nombreAlumno(int idAlumno) {
		Alumno a = alumnos.get(idAlumno);
		return a == null ? "Alumno #" + idAlumno : a.getNombre() + " " + a.getApellidos();
	}

	private String nombreCurso(int idCurso) {
		Curso c = cursos.get(idCurso);
		return c == null ? "Curso #" + idCurso : c.getNombre();
	}

	private String textoInscripcion(Inscripcion i) {
		return "#" + i.getIdInscripcion() + " - " + nombreAlumno(i.getIdAlumno())
				+ " - " + nombreCurso(i.getIdCurso());
	}

	private void cargarTabla() {
		try {
			listaPagos = servicio.listar();
			refrescarTabla();
			actualizarResumen();
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de pagos.", ex);
		}
	}

	private void refrescarTabla() {
		int idAlumnoFiltro = idDe(cmbFiltroAlumno);
		String metodo = (String) cmbFiltroMetodo.getSelectedItem();
		String estado = (String) cmbFiltroEstado.getSelectedItem();
		LocalDate desde = fechaOpcional(txtDesde);
		LocalDate hasta = fechaOpcional(txtHasta);

		modeloTabla.setRowCount(0);
		int mostrados = 0;
		BigDecimal sumaPagados = BigDecimal.ZERO;

		for (Pago p : listaPagos) {
			Inscripcion ins = inscripciones.get(p.getIdInscripcion());

			if (idAlumnoFiltro != 0 && (ins == null || ins.getIdAlumno() != idAlumnoFiltro)) {
				continue;
			}
			if (metodo != null && !metodo.startsWith("Todos") && !metodo.equals(p.getMetodoPago())) {
				continue;
			}
			if (estado != null && !estado.startsWith("Todos") && !estado.equals(p.getEstado())) {
				continue;
			}
			if (desde != null && p.getFechaPago().isBefore(desde)) {
				continue;
			}
			if (hasta != null && p.getFechaPago().isAfter(hasta)) {
				continue;
			}

			modeloTabla.addRow(new Object[] {
					p.getIdPago(),
					ins == null ? "-" : nombreAlumno(ins.getIdAlumno()),
					ins == null ? "-" : nombreCurso(ins.getIdCurso()),
					dinero(p.getMonto()),
					p.getFechaPago().format(FORMATO_FECHA),
					p.getMetodoPago(),
					p.getEstado()
			});
			mostrados++;
			if ("PAGADO".equals(p.getEstado())) {
				sumaPagados = sumaPagados.add(p.getMonto());
			}
		}
		lblTotal.setText("Pagos mostrados: " + mostrados
				+ "   |   Suma de pagos PAGADOS: " + dinero(sumaPagados));
	}

	private LocalDate fechaOpcional(JTextField campo) {
		String texto = campo.getText().trim();
		if (texto.length() != 10) {
			return null;
		}
		try {
			return LocalDate.parse(texto, FORMATO_FECHA);
		} catch (DateTimeParseException ex) {
			return null;
		}
	}

