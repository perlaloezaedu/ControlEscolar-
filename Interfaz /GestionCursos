	private void cargarMaestros() {
		try {
			for (Usuario u : usuarioServicio.listarMaestros()) {
				cmbMaestro.addItem(new Opcion(u.getIdUsuario(),
						u.getNombre() + " (" + u.getRol() + ")"));
				nombresMaestros.put(u.getIdUsuario(), u.getNombre());
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de maestros.", ex);
		}
	}

	private String nombreMaestro(int idMaestro) {
		String nombre = nombresMaestros.get(idMaestro);
		return nombre == null ? "Usuario #" + idMaestro : nombre;
	}

	private void cargarTabla() {
		try {
			listaCursos = servicio.listar();
			refrescarTabla();
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de cursos.", ex);
		}
	}

	private void refrescarTabla() {
		String filtro = txtBuscar.getText().trim().toLowerCase();
		modeloTabla.setRowCount(0);
		int mostrados = 0;

		for (Curso c : listaCursos) {
			String maestro = nombreMaestro(c.getIdMaestro());
			String texto = (c.getNombre() + " " + maestro + " " + c.getEstado()
					+ " " + nz(c.getDescripcion())).toLowerCase();

			if (!filtro.isEmpty() && !texto.contains(filtro)) {
				continue;
			}

			modeloTabla.addRow(new Object[] {
					c.getIdCurso(),
					c.getNombre(),
					maestro,
					String.valueOf(c.getDuracion()),
					dinero(c.getPrecio()),
					c.getEstado(),
					nz(c.getDescripcion())
			});
			mostrados++;
		}
		lblTotal.setText("Total de cursos: " + mostrados);
	}

	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo un curso ya registrado.\n"
					+ "Presiona \"Limpiar\" para capturar uno nuevo.");
			return;
		}

		try {
			if (servicio.registrar(leerFormulario())) {
				info("Curso registrado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo registrar el curso.", ex);
		}
	}

	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un curso de la tabla para modificarlo.");
			return;
		}

		try {
			if (servicio.modificar(leerFormulario())) {
				info("Curso modificado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo modificar el curso.", ex);
		}
	}

	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona un curso de la tabla para eliminarlo.");
			return;
		}

		int id = Integer.parseInt(txtId.getText());

		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar el curso \"" + txtNombre.getText() + "\"?\n"
						+ "También se eliminará su contenido.",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			if (servicio.eliminar(id)) {
				info("Curso eliminado correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			if (esLlaveForanea(ex)) {
				ofrecerDesactivar(id);
			} else {
				mostrarErrorBD("No se pudo eliminar el curso.", ex);
			}
		}
	}

	private void ofrecerDesactivar(int id) {
		int opcion = JOptionPane.showConfirmDialog(this,
				"Este curso tiene inscripciones registradas, por lo que no se puede eliminar.\n"
						+ "¿Deseas desactivarlo (estado INACTIVO) para conservar el historial?",
				"No se puede eliminar", JOptionPane.YES_NO_OPTION,
				JOptionPane.QUESTION_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			Curso curso = servicio.buscarPorId(id);
			if (curso != null) {
				curso.setEstado("INACTIVO");
				servicio.modificar(curso);
				info("El curso fue desactivado (INACTIVO).");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo desactivar el curso.", ex);
		}
	}
	
	private Curso leerFormulario() {
		String nombre = txtNombre.getText().trim();
		String descripcion = txtDescripcion.getText().trim();
		String duracionTexto = txtDuracion.getText().trim();
		String precioTexto = txtPrecio.getText().trim();

		if (nombre.isEmpty()) {
			throw new IllegalArgumentException("El nombre del curso es obligatorio.");
		}
		if (nombre.length() > 100) {
			throw new IllegalArgumentException("El nombre no puede pasar de 100 caracteres.");
		}
		if (descripcion.isEmpty()) {
			throw new IllegalArgumentException("La descripción es obligatoria.");
		}

		int idMaestro = idDe(cmbMaestro);
		if (idMaestro <= 0) {
			throw new IllegalArgumentException("Selecciona el maestro asignado al curso.");
		}

		int duracion;
		try {
			duracion = Integer.parseInt(duracionTexto);
		} catch (NumberFormatException ex) {
			throw new IllegalArgumentException(
					"La duración debe ser un número entero de horas.");
		}
		if (duracion <= 0) {
			throw new IllegalArgumentException("La duración debe ser un número positivo.");
		}

		if (precioTexto.isEmpty()) {
			throw new IllegalArgumentException("El precio es obligatorio.");
		}
		BigDecimal precio = parsearDecimal(precioTexto, "El precio");
		if (precio.signum() <= 0) {
			throw new IllegalArgumentException("El precio debe ser mayor que cero.");
		}

		Curso c = new Curso();
		if (!txtId.getText().isEmpty()) {
			c.setIdCurso(Integer.parseInt(txtId.getText()));
		}
		c.setNombre(nombre);
		c.setDescripcion(descripcion);
		c.setDuracion(duracion);
		c.setPrecio(precio);
		c.setIdMaestro(idMaestro);
		c.setEstado((String) cmbEstado.getSelectedItem());
		return c;
	}

	private void seleccionarFila() {
		int fila = tabla.getSelectedRow();
		if (fila == -1) {
			return;
		}

		int id = (Integer) tabla.getValueAt(fila, 0);

		for (Curso c : listaCursos) {
			if (c.getIdCurso() == id) {
				txtId.setText(String.valueOf(c.getIdCurso()));
				txtNombre.setText(c.getNombre());
				txtDescripcion.setText(nz(c.getDescripcion()));
				txtDuracion.setText(String.valueOf(c.getDuracion()));
				txtPrecio.setText(c.getPrecio().setScale(2, RoundingMode.HALF_UP).toPlainString());
				seleccionarOpcion(cmbMaestro, c.getIdMaestro());
				cmbEstado.setSelectedItem(c.getEstado());
				break;
			}
		}
	}

	private void limpiar() {
