	private void seleccionarOpcion(JComboBox<Opcion> combo, int id) {
		for (int i = 0; i < combo.getItemCount(); i++) {
			if (combo.getItemAt(i).id == id) {
				combo.setSelectedIndex(i);
				return;
			}
		}
	}

	private int idDe(JComboBox<Opcion> combo) {
		Opcion opcion = (Opcion) combo.getSelectedItem();
		return opcion == null ? 0 : opcion.id;
	}

	private BigDecimal parsearDecimal(String texto, String campo) {
		String limpio = texto.replace("$", "").replace(" ", "");
		if (limpio.contains(".") && limpio.contains(",")) {
			limpio = limpio.replace(",", "");
		} else {
			limpio = limpio.replace(',', '.');
		}
		try {
			return new BigDecimal(limpio).setScale(2, RoundingMode.HALF_UP);
		} catch (NumberFormatException ex) {
			throw new IllegalArgumentException(campo + " debe ser un número válido.");
		}
	}

	private String dinero(BigDecimal valor) {
		return "$" + String.format(Locale.US, "%,.2f", valor);
	}

	private boolean esLlaveForanea(SQLException ex) {
		return ex.getErrorCode() == 1451
				|| (ex instanceof SQLIntegrityConstraintViolationException
						&& ex.getErrorCode() != 1062);
	}

	private void alEscribir(JTextField campo, Runnable accion) {
		campo.getDocument().addDocumentListener(new DocumentListener() {
			@Override
			public void insertUpdate(DocumentEvent e) {
				accion.run();
			}

			@Override
			public void removeUpdate(DocumentEvent e) {
				accion.run();
			}

			@Override
			public void changedUpdate(DocumentEvent e) {
				accion.run();
			}
		});
	}
}
