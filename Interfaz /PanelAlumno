	public void cargarDatos(Usuario usuario) {
		lblSubtitulo.setText("Hola, " + usuario.getNombre());

		try {
			alumno = alumnoServicio.buscarPorUsuario(usuario.getIdUsuario());

			if (alumno == null) {
				lblSubtitulo.setText("Tu cuenta aún no está vinculada a un expediente de alumno. "
						+ "Pide al administrador que te cree el acceso.");
				cmbCurso.setEnabled(false);
				return;
			}

			for (Curso c : cursoServicio.listar()) {
				cursos.put(c.getIdCurso(), c);
			}

			List<Inscripcion> mias = new ArrayList<>();
			for (Inscripcion i : inscripcionServicio.listar()) {
				if (i.getIdAlumno() == alumno.getIdAlumno()) {
					inscripciones.put(i.getIdInscripcion(), i);
					mias.add(i);
				}
			}

			misCalificaciones.clear();
			for (Calificacion c : calificacionServicio.listar()) {
				if (inscripciones.containsKey(c.getIdInscripcion())) {
					misCalificaciones.add(c);
				}
			}

			misPagos.clear();
			for (Pago p : pagoServicio.listar()) {
				if (inscripciones.containsKey(p.getIdInscripcion())) {
					misPagos.add(p);
				}
			}

			contenidos = contenidoServicio.listar();

			lblSubtitulo.setText("Hola, " + alumno.getNombre() + " " + alumno.getApellidos());

			cmbCurso.removeAllItems();
			for (Inscripcion i : mias) {
				Curso curso = cursos.get(i.getIdCurso());
				String nombre = curso == null ? "Curso #" + i.getIdCurso() : curso.getNombre();
				cmbCurso.addItem(new Opcion(i.getIdInscripcion(), nombre));
			}

			if (mias.isEmpty()) {
				lblEstadoInscripcion.setText("Todavía no estás inscrito en ningún curso.");
			}

		} catch (SQLException ex) {
			JOptionPane.showMessageDialog(this,
					"No se pudo cargar tu información.\n" + ex.getMessage(),
					"Error de base de datos", JOptionPane.ERROR_MESSAGE);
		}
	}

	private void actualizarVista() {
		modeloCalificaciones.setRowCount(0);
		modeloPagos.setRowCount(0);

		Opcion elegido = (Opcion) cmbCurso.getSelectedItem();
		Inscripcion inscripcion = elegido == null ? null : inscripciones.get(elegido.id);

		if (inscripcion == null) {
			lblNumPromedio.setText("-");
			lblNumEvaluaciones.setText("0");
			lblNumAvance.setText("0%");
			barraAvance.setValue(0);
			lblDetalleAvance.setText("");
			lblNumSaldo.setText("$0.00");
			lblResumenPagos.setText("");
			return;
		}

		lblEstadoInscripcion.setText("Estado de tu inscripción: " + inscripcion.getEstado());

		BigDecimal suma = BigDecimal.ZERO;
		int evaluaciones = 0;
		for (Calificacion c : misCalificaciones) {
			if (c.getIdInscripcion() == inscripcion.getIdInscripcion()) {
				suma = suma.add(c.getCalificacion());
				evaluaciones++;
				modeloCalificaciones.addRow(new Object[] {
						c.getTipoEvaluacion(),
						c.getCalificacion().setScale(2, RoundingMode.HALF_UP).toPlainString(),
						c.getFechaEvaluacion().format(FORMATO_FECHA),
						c.getObservaciones() == null ? "" : c.getObservaciones()
				});
			}
		}

		if (evaluaciones == 0) {
			lblNumPromedio.setText("-");
		} else {
			lblNumPromedio.setText(suma.divide(BigDecimal.valueOf(evaluaciones), 2,
					RoundingMode.HALF_UP).toPlainString());
		}
		lblNumEvaluaciones.setText(String.valueOf(evaluaciones));

		int temas = 0;
		for (ContenidoCurso c : contenidos) {
			if (c.getIdCurso() == inscripcion.getIdCurso()) {
				temas++;
			}
		}

		int avance = temas == 0 ? 0 : Math.min(100, evaluaciones * 100 / temas);
		barraAvance.setValue(avance);
		lblNumAvance.setText(avance + "%");
		lblDetalleAvance.setText(temas == 0 ? "El curso aún no tiene temas"
				: evaluaciones + " evaluaciones de " + temas + " temas");

		BigDecimal pagado = BigDecimal.ZERO;
		for (Pago p : misPagos) {
			if (p.getIdInscripcion() == inscripcion.getIdInscripcion()) {
				modeloPagos.addRow(new Object[] {
						p.getFechaPago().format(FORMATO_FECHA),
						dinero(p.getMonto()),
						p.getMetodoPago(),
						p.getEstado()
				});
				if ("PAGADO".equals(p.getEstado())) {
					pagado = pagado.add(p.getMonto());
				}
			}
		}

		Curso curso = cursos.get(inscripcion.getIdCurso());
		BigDecimal costo = curso == null ? BigDecimal.ZERO : curso.getPrecio();
		BigDecimal saldo = costo.subtract(pagado);
		if (saldo.signum() < 0) {
			saldo = BigDecimal.ZERO;
		}

		lblNumSaldo.setText(dinero(saldo));
		lblResumenPagos.setText("<html>Costo del curso: " + dinero(costo)
				+ "<br>Total pagado: " + dinero(pagado) + "</html>");
	}

	private String dinero(BigDecimal valor) {
		return "$" + String.format(Locale.US, "%,.2f", valor);
	}

	private void estilizarTabla(JTable tabla) {
		tabla.setFont(new Font("SansSerif", Font.PLAIN, 13));
		tabla.setRowHeight(26);
		tabla.setForeground(AZUL_OSCURO);
		tabla.setGridColor(new Color(225, 232, 243));
		tabla.setSelectionBackground(new Color(219, 234, 254));
		tabla.setSelectionForeground(AZUL_OSCURO);
		tabla.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
		tabla.getTableHeader().setReorderingAllowed(false);
		tabla.getTableHeader().setPreferredSize(new Dimension(100, 30));

		EncabezadoTabla encabezado = new EncabezadoTabla();
		for (int i = 0; i < tabla.getColumnCount(); i++) {
			tabla.getColumnModel().getColumn(i).setHeaderRenderer(encabezado);
		}
	}

	private void cerrarSesion() {
		int opcion = JOptionPane.showConfirmDialog(
				this, "¿Deseas cerrar la sesión?", "Cerrar sesión",
				JOptionPane.YES_NO_OPTION,
				JOptionPane.QUESTION_MESSAGE);

		if (opcion == JOptionPane.YES_OPTION) {
			Login login = new Login();
			login.setLocationRelativeTo(null);
			login.setVisible(true);
			dispose();
		}
	}

