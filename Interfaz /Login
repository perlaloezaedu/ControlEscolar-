package poo.interfaz;

import poo.modelo.Usuario;
import poo.servicio.AutenticacionServicio;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.sql.SQLException;
import java.util.Optional;

public class Login extends JFrame {

    private static final long serialVersionUID = 1L;

    private JTextField txtCorreo;
    private JPasswordField txtContrasena;
    private JButton btnIngresar;
    private JButton btnSalir;

    private final Color azul = new Color(37, 99, 235);
    private final Color azulOscuro = new Color(20, 40, 90);
    private final Color gris = new Color(100, 116, 139);

    private final AutenticacionServicio autenticacionServicio =
            new AutenticacionServicio();

    public Login() {
        configurarVentana();
        crearInterfaz();
    }

    private void configurarVentana() {
        setTitle("EduControl - Inicio de sesión");
        setSize(850, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);
    }

    private void crearInterfaz() {
        JPanel principal = new JPanel(new BorderLayout(0, 20));
        principal.setBackground(Color.WHITE);
        principal.setBorder(new EmptyBorder(25, 45, 25, 45));

        JPanel encabezado = new JPanel();
        encabezado.setLayout(new BoxLayout(encabezado, BoxLayout.Y_AXIS));
        encabezado.setBackground(Color.WHITE);

        JLabel titulo = new JLabel("EDUCONTROL");
        titulo.setFont(new Font("SansSerif", Font.BOLD, 34));
        titulo.setForeground(azulOscuro);
        titulo.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel subtitulo = new JLabel("Sistema de Gestión Educativa");
        subtitulo.setFont(new Font("SansSerif", Font.PLAIN, 17));
        subtitulo.setForeground(gris);
        subtitulo.setAlignmentX(Component.CENTER_ALIGNMENT);
        encabezado.add(titulo);
        encabezado.add(subtitulo);

        JPanel formulario = new JPanel(null);
        formulario.setBackground(Color.WHITE);
        formulario.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(220, 230, 243), 2), new EmptyBorder(20, 25, 20, 25)
        ));

        JLabel tituloLogin = new JLabel("Iniciar sesión");
        tituloLogin.setBounds(250, 15, 220, 35);
        tituloLogin.setFont(
                new Font("SansSerif", Font.BOLD, 27));
        tituloLogin.setForeground(azulOscuro);

        JLabel etiquetaCorreo =
                new JLabel("Correo electrónico:");
        etiquetaCorreo.setBounds(27, 65, 200, 25);
        etiquetaCorreo.setFont(
                new Font("SansSerif", Font.BOLD, 15));
        etiquetaCorreo.setForeground(azulOscuro);

        txtCorreo = new JTextField();
        txtCorreo.setBounds(27, 95, 692, 42);
        txtCorreo.setFont(
                new Font("SansSerif", Font.PLAIN, 16));
        txtCorreo.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(
                        new Color(203, 216, 237), 1),
                new EmptyBorder(8, 10, 8, 10)
        ));

        JLabel etiquetaContrasena = new JLabel("Contraseña:");
        etiquetaContrasena.setBounds(27, 150, 150, 25);
        etiquetaContrasena.setFont(
                new Font("SansSerif", Font.BOLD, 15));
        etiquetaContrasena.setForeground(azulOscuro);

        txtContrasena = new JPasswordField();
        txtContrasena.setBounds(27, 180, 692, 42);
        txtContrasena.setFont(
                new Font("SansSerif", Font.PLAIN, 16));
        txtContrasena.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(
                        new Color(203, 216, 237), 1),
                new EmptyBorder(8, 10, 8, 10)
        ));

        btnIngresar = new JButton("Ingresar");
        btnIngresar.setBounds(42, 245, 652, 45);
        btnIngresar.setFont(
                new Font("SansSerif", Font.BOLD, 16));
        btnIngresar.setForeground(Color.WHITE);
        btnIngresar.setBackground(azul);
        btnIngresar.setFocusPainted(false);
        btnIngresar.setCursor(
                new Cursor(Cursor.HAND_CURSOR));

        btnSalir = new JButton("Salir");
        btnSalir.setBounds(42, 300, 652, 42);
        btnSalir.setFont(
                new Font("SansSerif", Font.BOLD, 15));
        btnSalir.setForeground(azulOscuro);
        btnSalir.setBackground(new Color(239, 244, 251));
        btnSalir.setFocusPainted(false);
        btnSalir.setCursor(
                new Cursor(Cursor.HAND_CURSOR));

        formulario.add(tituloLogin);
        formulario.add(etiquetaCorreo);
        formulario.add(txtCorreo);
        formulario.add(etiquetaContrasena);
        formulario.add(txtContrasena);
        formulario.add(btnIngresar);
        formulario.add(btnSalir);

        principal.add(encabezado, BorderLayout.NORTH);
        principal.add(formulario, BorderLayout.CENTER);

        setContentPane(principal);

        btnIngresar.addActionListener(e -> iniciarSesion());
        btnSalir.addActionListener(e -> salir());

        getRootPane().setDefaultButton(btnIngresar);
    }

    private void iniciarSesion() {
        String correo = txtCorreo.getText().trim();
        String contrasena =
                new String(txtContrasena.getPassword());

        if (correo.isEmpty() || contrasena.isEmpty()) {
            JOptionPane.showMessageDialog(
                    this,
                    "Ingresa tu correo electrónico y contraseña.",
                    "Datos incompletos",
                    JOptionPane.WARNING_MESSAGE
            );
            return;
        }

        btnIngresar.setEnabled(false);

        try {
            Optional<Usuario> resultado =
                    autenticacionServicio.iniciarSesion(
                            correo, contrasena);

            if (resultado.isPresent()) {
                Usuario usuario = resultado.get();

                JOptionPane.showMessageDialog(
                        this,
                        "Bienvenido, " + usuario.getNombre() + ".",
                        "Acceso correcto",
                        JOptionPane.INFORMATION_MESSAGE
                );
                if ("ALUMNO".equalsIgnoreCase(usuario.getRol())) {
                    PanelAlumno panel = new PanelAlumno();
                    panel.cargarDatos(usuario);
                    panel.setLocationRelativeTo(null);
                    panel.setVisible(true);
                } else {
                    MenuPrincipal menu = new MenuPrincipal();
                    menu.establecerUsuario(usuario.getNombre(), usuario.getRol());
                    menu.setLocationRelativeTo(null);
                    menu.setVisible(true);
                }
                dispose();

            } else {
                JOptionPane.showMessageDialog(
                        this,
                        "Correo o contraseña incorrectos, "
                                + "o usuario inactivo.",
                        "Acceso denegado",
                        JOptionPane.ERROR_MESSAGE
                );

                txtContrasena.setText("");
                txtContrasena.requestFocus();
            }

        } catch (IllegalArgumentException ex) {
            JOptionPane.showMessageDialog(
                    this,
                    ex.getMessage(),
                    "Datos inválidos",
                    JOptionPane.WARNING_MESSAGE
            );

        } catch (SQLException ex) {
            JOptionPane.showMessageDialog(
                    this,
                    "No se pudo acceder a la base de datos.\n"
                            + ex.getMessage(),
                    "Error de conexión",
                    JOptionPane.ERROR_MESSAGE
            );

        } catch (Exception ex) {
            JOptionPane.showMessageDialog(
                    this,
                    "Ocurrió un error al iniciar sesión.\n"
                            + ex.getMessage(),
                    "Error",
                    JOptionPane.ERROR_MESSAGE
            );

        } finally {
            if (isDisplayable()) {
                btnIngresar.setEnabled(true);
            }
        }
    }

    private void salir() {
        int opcion = JOptionPane.showConfirmDialog(
                this,
                "¿Deseas salir de EduControl?",
                "Confirmar salida",
                JOptionPane.YES_NO_OPTION
        );

        if (opcion == JOptionPane.YES_OPTION) {
            dispose();
            System.exit(0);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            Login ventana = new Login();
            ventana.setVisible(true);
        });
    }
}
