	private static class Opcion {
		final int id;
		final String texto;

		Opcion(int id, String texto) {
			this.id = id;
			this.texto = texto;
		}

		@Override
		public String toString() {
			return texto;
		}
	}

	private void seleccionarOpcion(JComboBox<Opcion> combo, int id) {
		for (int i = 0; i < combo.getItemCount(); i++) {
			if (combo.getItemAt(i).id == id) {
				combo.setSelectedIndex(i);
				return;
			}
		}
	}

	private int idDe(JComboBox<Opcion> combo) {
		Opcion opcion = (Opcion) combo.getSelectedItem();
		return opcion == null ? 0 : opcion.id;
	}

	private LocalDate parsearFecha(String texto) {
		try {
			return LocalDate.parse(texto.trim(), FORMATO_FECHA);
		} catch (DateTimeParseException ex) {
			throw new IllegalArgumentException(
					"Fecha inválida. Usa el formato dd/mm/aaaa (ejemplo: 25/03/2026).");
		}
	}

	private String hoy() {
		return LocalDate.now().format(FORMATO_FECHA);
	}

	private boolean esLlaveForanea(SQLException ex) {
		return ex.getErrorCode() == 1451
				|| (ex instanceof SQLIntegrityConstraintViolationException
						&& ex.getErrorCode() != 1062);
	}
}
