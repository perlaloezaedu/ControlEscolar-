	private void crearEventos() {
		btnRegistrar.addActionListener(e -> registrar());
		btnModificar.addActionListener(e -> modificar());
		btnEliminar.addActionListener(e -> eliminar());
		btnLimpiar.addActionListener(e -> limpiar());
		btnVolver.addActionListener(e -> dispose());

		tabla.getSelectionModel().addListSelectionListener(e -> {
			if (!e.getValueIsAdjusting()) {
				seleccionarFila();
			}
		});

		cmbFiltroCurso.addActionListener(e -> refrescarTabla());
		cmbFiltroEstado.addActionListener(e -> refrescarTabla());
	}

	private void cargarCatalogos() {
		try {
			for (Alumno a : alumnoServicio.listar()) {
				alumnos.put(a.getIdAlumno(), a);
				cmbAlumno.addItem(new Opcion(a.getIdAlumno(),
						nombreAlumno(a) + ("ACTIVO".equals(a.getEstado()) ? "" : " (INACTIVO)")));
			}

			cmbFiltroCurso.addItem(new Opcion(0, "Todos"));
			for (Curso c : cursoServicio.listar()) {
				cursos.put(c.getIdCurso(), c);
				String texto = c.getNombre()
						+ ("ACTIVO".equals(c.getEstado()) ? "" : " (INACTIVO)");
				cmbCurso.addItem(new Opcion(c.getIdCurso(), texto));
				cmbFiltroCurso.addItem(new Opcion(c.getIdCurso(), texto));
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudieron cargar alumnos y cursos.", ex);
		}
	}

	private String nombreAlumno(Alumno a) {
		return a.getNombre() + " " + a.getApellidos();
	}

	private String textoAlumno(int idAlumno) {
		Alumno a = alumnos.get(idAlumno);
		return a == null ? "Alumno #" + idAlumno : nombreAlumno(a);
	}

	private String textoCurso(int idCurso) {
		Curso c = cursos.get(idCurso);
		return c == null ? "Curso #" + idCurso : c.getNombre();
	}

	private void cargarTabla() {
		try {
			listaInscripciones = servicio.listar();
			refrescarTabla();
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cargar la lista de inscripciones.", ex);
		}
	}

	private void refrescarTabla() {
		int idCursoFiltro = idDe(cmbFiltroCurso);
		String estadoFiltro = (String) cmbFiltroEstado.getSelectedItem();
		modeloTabla.setRowCount(0);
		int mostrados = 0;

		for (Inscripcion i : listaInscripciones) {
			if (idCursoFiltro != 0 && i.getIdCurso() != idCursoFiltro) {
				continue;
			}
			if (estadoFiltro != null && !"Todos".equals(estadoFiltro)
					&& !estadoFiltro.equals(i.getEstado())) {
				continue;
			}

			modeloTabla.addRow(new Object[] {
					i.getIdInscripcion(),
					textoAlumno(i.getIdAlumno()),
					textoCurso(i.getIdCurso()),
					i.getFechaInscripcion().format(FORMATO_FECHA),
					i.getEstado()
			});
			mostrados++;
		}
		lblTotal.setText("Total de inscripciones: " + mostrados);
	}

	private void registrar() {
		if (!txtId.getText().isEmpty()) {
			aviso("Estás viendo una inscripción ya registrada.\n"
					+ "Presiona \"Limpiar\" para capturar una nueva.");
			return;
		}

		try {
			Inscripcion inscripcion = leerFormulario();

			Alumno alumno = alumnos.get(inscripcion.getIdAlumno());
			Curso curso = cursos.get(inscripcion.getIdCurso());
			if (alumno == null || !"ACTIVO".equals(alumno.getEstado())) {
				throw new IllegalArgumentException("El alumno seleccionado está inactivo.");
			}
			if (curso == null || !"ACTIVO".equals(curso.getEstado())) {
				throw new IllegalArgumentException("El curso seleccionado está inactivo.");
			}

			if (servicio.registrar(inscripcion)) {
				info("Inscripción registrada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			if (ex.getErrorCode() == 1062) {
				aviso("Ese alumno ya está inscrito en ese curso.");
			} else {
				mostrarErrorBD("No se pudo registrar la inscripción.", ex);
			}
		}
	}

	private void modificar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona una inscripción de la tabla para modificarla.");
			return;
		}

		try {
			if (servicio.modificar(leerFormulario())) {
				info("Inscripción modificada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (IllegalArgumentException ex) {
			aviso(ex.getMessage());
		} catch (SQLException ex) {
			if (ex.getErrorCode() == 1062) {
				aviso("Ese alumno ya está inscrito en ese curso.");
			} else {
				mostrarErrorBD("No se pudo modificar la inscripción.", ex);
			}
		}
	}

	private void eliminar() {
		if (txtId.getText().isEmpty()) {
			aviso("Selecciona una inscripción de la tabla para eliminarla.");
			return;
		}

		int id = Integer.parseInt(txtId.getText());

		int opcion = JOptionPane.showConfirmDialog(this,
				"¿Seguro que deseas eliminar esta inscripción?",
				"Confirmar eliminación",
				JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			if (servicio.eliminar(id)) {
				info("Inscripción eliminada correctamente.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			if (esLlaveForanea(ex)) {
				ofrecerCancelar(id);
			} else {
				mostrarErrorBD("No se pudo eliminar la inscripción.", ex);
			}
		}
	}

	private void ofrecerCancelar(int id) {
		int opcion = JOptionPane.showConfirmDialog(this,
				"Esta inscripción ya tiene pagos o calificaciones, por lo que no se puede eliminar.\n"
						+ "¿Deseas marcarla como CANCELADO para conservar el historial?",
				"No se puede eliminar", JOptionPane.YES_NO_OPTION,
				JOptionPane.QUESTION_MESSAGE);

		if (opcion != JOptionPane.YES_OPTION) {
			return;
		}

		try {
			Inscripcion inscripcion = servicio.buscarPorId(id);
			if (inscripcion != null) {
				inscripcion.setEstado("CANCELADO");
				servicio.modificar(inscripcion);
				info("La inscripción fue marcada como CANCELADO.");
				limpiar();
				cargarTabla();
			}
		} catch (SQLException ex) {
			mostrarErrorBD("No se pudo cancelar la inscripción.", ex);
		}
	}

	private Inscripcion leerFormulario() {
		int idAlumno = idDe(cmbAlumno);
		int idCurso = idDe(cmbCurso);

		if (idAlumno <= 0) {
			throw new IllegalArgumentException("Selecciona el alumno.");
		}
		if (idCurso <= 0) {
			throw new IllegalArgumentException("Selecciona el curso.");
		}
		if (txtFecha.getText().trim().isEmpty()) {
			throw new IllegalArgumentException("La fecha de inscripción es obligatoria.");
		}

		Inscripcion i = new Inscripcion();
		if (!txtId.getText().isEmpty()) {
			i.setIdInscripcion(Integer.parseInt(txtId.getText()));
		}
		i.setIdAlumno(idAlumno);
		i.setIdCurso(idCurso);
		i.setFechaInscripcion(parsearFecha(txtFecha.getText()));
		i.setEstado((String) cmbEstado.getSelectedItem());
		return i;
	}

	private void seleccionarFila() {
		int fila = tabla.getSelectedRow();
		if (fila == -1) {
			return;
		}

		int id = (Integer) tabla.getValueAt(fila, 0);

		for (Inscripcion i : listaInscripciones) {
			if (i.getIdInscripcion() == id) {
				txtId.setText(String.valueOf(i.getIdInscripcion()));
				seleccionarOpcion(cmbAlumno, i.getIdAlumno());
				seleccionarOpcion(cmbCurso, i.getIdCurso());
				txtFecha.setText(i.getFechaInscripcion().format(FORMATO_FECHA));
				cmbEstado.setSelectedItem(i.getEstado());
				break;
			}
		}
	}

	private void limpiar() {
		txtId.setText("");
		txtFecha.setText(hoy());
		cmbEstado.setSelectedItem("ACTIVO");
		tabla.clearSelection();
		cmbAlumno.requestFocusInWindow();
	}

