package poo.dao;

import poo.conexion.Conexion;
import poo.modelo.Usuario;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

public class UsuarioDAO {

    public Optional<Usuario> buscarPorCorreoYContrasena(
            String correo, String contraseña) throws SQLException {

        String sql = "SELECT id_usuario, nombre, correo, "
                   + "`contraseña`, rol, estado "
                   + "FROM usuarios "
                   + "WHERE correo = ? AND `contraseña` = ? "
                   + "AND estado = 'ACTIVO'";

        try (Connection conexion = Conexion.conectar();
             PreparedStatement ps = conexion.prepareStatement(sql)) {

            ps.setString(1, correo);
            ps.setString(2, contraseña);

            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    Usuario usuario = new Usuario(
                        rs.getInt("id_usuario"),
                        rs.getString("nombre"),
                        rs.getString("correo"),
                        rs.getString("contraseña"),
                        rs.getString("rol"),
                        rs.getString("estado")
                    );

                    return Optional.of(usuario);
                }
            }
        }

        return Optional.empty();
    }

    public Optional<Usuario> buscarPorCorreo(String correo)
            throws SQLException {

        String sql = "SELECT id_usuario, nombre, correo, "
                   + "`contraseña`, rol, estado "
                   + "FROM usuarios WHERE correo = ?";

        try (Connection conexion = Conexion.conectar();
             PreparedStatement ps = conexion.prepareStatement(sql)) {

            ps.setString(1, correo);

            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    Usuario usuario = new Usuario(
                        rs.getInt("id_usuario"),
                        rs.getString("nombre"),
                        rs.getString("correo"),
                        rs.getString("contraseña"),
                        rs.getString("rol"),
                        rs.getString("estado")
                    );

                    return Optional.of(usuario);
                }
            }
        }

        return Optional.empty();
    }

    public List<Usuario> listarMaestros() throws SQLException {
        List<Usuario> lista = new ArrayList<>();

        String sql = "SELECT id_usuario, nombre, correo, rol, estado "
                   + "FROM usuarios "
                   + "WHERE rol IN ('MAESTRO', 'ADMINISTRADOR') "
                   + "AND estado = 'ACTIVO' ORDER BY nombre";

        try (Connection conexion = Conexion.conectar();
             PreparedStatement ps = conexion.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                lista.add(new Usuario(
                    rs.getInt("id_usuario"),
                    rs.getString("nombre"),
                    rs.getString("correo"),
                    null,
                    rs.getString("rol"),
                    rs.getString("estado")
                ));
            }
        }

        return lista;
    }

    public int crearAccesoAlumno(int idAlumno, String nombre,
            String correo, String contraseña) throws SQLException {

        String sqlUsuario = "INSERT INTO usuarios "
                          + "(nombre, correo, `contraseña`, rol, estado) "
                          + "VALUES (?, ?, ?, 'ALUMNO', 'ACTIVO')";

        String sqlAlumno = "UPDATE alumnos SET id_usuario = ? "
                         + "WHERE id_alumno = ? AND id_usuario IS NULL";

        try (Connection conexion = Conexion.conectar()) {
            conexion.setAutoCommit(false);

            try (PreparedStatement psUsuario = conexion.prepareStatement(
                    sqlUsuario, Statement.RETURN_GENERATED_KEYS)) {

                psUsuario.setString(1, nombre);
                psUsuario.setString(2, correo);
                psUsuario.setString(3, contraseña);
                psUsuario.executeUpdate();

                int idUsuario;
                try (ResultSet claves = psUsuario.getGeneratedKeys()) {
                    if (!claves.next()) {
                        throw new SQLException("No se pudo obtener el ID del usuario creado.");
                    }
                    idUsuario = claves.getInt(1);
                }

                try (PreparedStatement psAlumno =
                         conexion.prepareStatement(sqlAlumno)) {
                    psAlumno.setInt(1, idUsuario);
                    psAlumno.setInt(2, idAlumno);

                    if (psAlumno.executeUpdate() == 0) {
                        throw new SQLException("El alumno ya tiene un acceso asignado.");
                    }
                }

                conexion.commit();
                return idUsuario;

            } catch (SQLException ex) {
                conexion.rollback();
                throw ex;
            }
        }
    }
}
